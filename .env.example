# Copy to .env and fill in real values

# Stripe secret key (test mode) - https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Currency used for the Stripe PaymentIntent.
# NOTE: Stripe does not support Bangladeshi accounts or BDT settlement.
# This demo charges in USD under the hood while the UI displays prices in
# BDT (৳) for the Bangladeshi audience. For real BDT charges, replace the
# logic in routes/checkout.js with SSLCommerz or a bKash Merchant API
# integration instead - everything else in the app stays the same.
STRIPE_CURRENCY=usd

PORT=4000
FRONTEND_URL=http://localhost:3000
